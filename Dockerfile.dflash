# EXPERIMENTAL — Qwen3.6 DFlash speculative decoding on PCAI.
#
# Adds vLLM PR #40898 (DFlash + sliding-window attention for Qwen3.6), which is OPEN
# upstream and conflicts with v0.23.0. patches/40898-on-v0.23.0.patch is that PR rebased
# and conflict-resolved against this exact base (3 conflicts: gpu_model_runner.py kept
# v0.23.0's eagle handling; qwen3_dflash.py took the union ctor kwargs; dflash.py took the
# PR's inline SWA causal/non-causal metadata). It is PURE PYTHON — no CUDA recompile (DFlash
# core kernels are already in v0.23.0 via #43445).
#
# NOT VALIDATED ON GPU. The patch applies + imports clean; it has NOT been proven to boot on
# the hybrid GDN model, survive num_speculative_tokens>=10 (upstream #42084), or accept well.
# Treat as a throwaway pilot image, not production. Regenerate the patch if you bump the base.
FROM vllm/vllm-openai:v0.23.0-cu129-ubuntu2404

COPY patches/40898-on-v0.23.0.patch /tmp/dflash.patch
# Enhanced Qwen template, same as the production image (PCAI can't mount volumes).
COPY chat-template-fix/chat-template/*.jinja /templates/

RUN set -eux; \
    VLLM_DIR="$(python3 -c 'import vllm, os; print(os.path.dirname(vllm.__file__))')"; \
    SITE="$(dirname "$VLLM_DIR")"; \
    if command -v git >/dev/null 2>&1; then git -C "$SITE" apply -p1 --verbose /tmp/dflash.patch; \
    elif command -v patch >/dev/null 2>&1; then patch -p1 -d "$SITE" < /tmp/dflash.patch; \
    else echo "need git or patch in base image to apply the DFlash patch"; exit 1; fi; \
    find "$VLLM_DIR" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true; \
    rm -f /tmp/dflash.patch

# Build-time tripwire: a bad/partial apply fails HERE, not on the GPU.
RUN python3 - <<'PY'
import vllm
import vllm.config.speculative
import vllm.v1.spec_decode.dflash, vllm.v1.spec_decode.llm_base_proposer
import vllm.model_executor.models.qwen3_dflash
import vllm.v1.worker.gpu_model_runner, vllm.v1.core.sched.scheduler
print("DFlash #40898 patch import OK:", vllm.__version__)
PY

# Serve (note: FP8-weight target OK, BF16 KV to dodge #41559, num_spec<10 to dodge #42084):
#   Qwen/Qwen3.6-27B-FP8 --served-model-name Qwen3.6-27B --tensor-parallel-size 1 \
#     --max-model-len 262144 --gpu-memory-utilization 0.92 --kv-cache-dtype auto \
#     --speculative-config={"method":"dflash","model":"z-lab/Qwen3.6-27B-DFlash","num_speculative_tokens":8} \
#     --attention-backend flash_attn --chat-template /templates/qwen3.6-enhanced.jinja --port 8080
