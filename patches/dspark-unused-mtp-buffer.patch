+def _pcai_dspark_aux_only(vllm_config: VllmConfig) -> bool:
+    if os.environ.get("VLLM_PCAI_DSPARK_SKIP_MTP_BUFFER") != "1":
+        return False
+    spec = vllm_config.speculative_config
+    if (
+        spec is None
+        or not spec.use_dspark()
+        or not vllm_config.use_v2_model_runner
+        or vllm_config.parallel_config.pipeline_parallel_size != 1
+    ):
+        return False
+    from vllm.v1.worker.gpu.spec_decode.eagle.eagle3_utils import (
+        get_eagle3_aux_layers_from_config,
+    )
+
+    # Only omit the residual when the drafter is configured to consume aux
+    # states. MTP and missing/invalid aux configurations retain their fallback.
+    layers = get_eagle3_aux_layers_from_config(spec)
+    num_layers = vllm_config.model_config.hf_config.num_hidden_layers
+    return bool(layers) and all(
+        isinstance(layer, int) and 1 <= layer <= num_layers for layer in layers
+    )
+
