+# JSON {"layers": {"0": [ids], "1": [...], ...}}: the routed experts each draft
+# layer keeps, as checkpoint ids. The drafter is built with that many experts;
+# the others are not loaded, and the router keeps only the matching rows.
+_KEPT_EXPERTS_ENV = "VLLM_PCAI_DSPARK_KEPT_EXPERTS"
+# Directory: record each draft layer's MoE inputs and routing for calibration.
+_CAPTURE_DIR_ENV = "VLLM_PCAI_DSPARK_CAPTURE_DIR"
