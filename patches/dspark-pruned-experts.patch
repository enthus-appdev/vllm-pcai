+def _load_kept_experts(
+    path: str, num_layers: int, num_experts: int, top_k: int
+) -> list[list[int]]:
+    with open(path) as f:
+        layers = json.load(f)["layers"]
+    kept = [layers[str(i)] for i in range(num_layers)]
+    for i, ids in enumerate(kept):
+        if ids != sorted(set(ids)) or not all(0 <= e < num_experts for e in ids):
+            raise ValueError(
+                f"{path}: layer {i} must list sorted, unique expert ids "
+                f"in [0, {num_experts})"
+            )
+    if len({len(ids) for ids in kept}) != 1 or not top_k <= len(kept[0]):
+        raise ValueError(
+            f"{path}: every draft layer must keep the same number of experts, "
+            f"at least top-k ({top_k})"
+        )
+    return kept
+
+
+def _select_kept_experts(
+    weights: Iterable[tuple[str, torch.Tensor]], kept: list[list[int]]
+) -> Iterable[tuple[str, torch.Tensor]]:
+    """Drop unkept draft experts, renumber kept ones, slice router rows."""
+    new_id = [{old: new for new, old in enumerate(ids)} for ids in kept]
+    rows = [torch.tensor(ids, dtype=torch.long) for ids in kept]
+    for name, weight in weights:
+        if m := _MTP_EXPERT_RE.match(name):
+            layer = int(m.group(1))
+            new = new_id[layer].get(int(m.group(2)))
+            if new is None:
+                continue
+            name = f"mtp.{layer}.ffn.experts.{new}.{name[m.end() :]}"
+        elif m := _MTP_ROUTER_RE.match(name):
+            index = rows[int(m.group(1))].to(weight.device)
+            weight = weight.index_select(0, index)
+        yield name, weight
+
