+class _RouterCapture:
+    """Record what each draft-layer router sees and selects (calibration).
+
+    Rank 0 writes, per draft layer, its MoE input hidden states, input ids and
+    the selected experts with their normalized gate weights. Recording starts
+    only once the worker finished warmup, so profiling and warmup batches are
+    excluded. Requires eager execution: graph replay bypasses this hook.
+    """
+
+    armed = False
+
+    def __init__(self, directory: str, max_tokens: int) -> None:
+        from vllm.distributed import get_tensor_model_parallel_rank
+
+        self.directory = directory
+        self.max_tokens = max_tokens
+        self.enabled = get_tensor_model_parallel_rank() == 0
+        self.counts: dict[int, int] = {}
+        self.pending: dict[int, list[dict[str, torch.Tensor]]] = {}
+        self.files: dict[int, int] = {}
+        if self.enabled:
+            os.makedirs(directory, exist_ok=True)
+            atexit.register(self.flush_all)
+
+    def flush_all(self) -> None:
+        for layer in list(self.pending):
+            self._flush(layer)
+
+    def wrap(self, layer: int, moe: nn.Module) -> None:
+        forward = moe.forward
+
+        def capture_forward(hidden_states, input_ids=None, mega_gate_metadata=None):
+            if self.enabled and _RouterCapture.armed:
+                self._record(layer, moe, hidden_states, input_ids)
+            return forward(hidden_states, input_ids, mega_gate_metadata)
+
+        moe.forward = capture_forward
+
+    @torch.inference_mode()
+    def _record(self, layer, moe, hidden_states, input_ids) -> None:
+        from vllm.model_executor.layers.fused_moe.router.fused_topk_bias_router import (  # noqa: E501
+            fused_topk_bias,
+        )
+
+        count = self.counts.get(layer, 0)
+        if count >= self.max_tokens or hidden_states.shape[0] == 0:
+            return
+        valid = slice(None)
+        if is_forward_context_available():
+            is_padding = get_forward_context().is_padding
+            if is_padding is not None:
+                valid = ~is_padding[: hidden_states.shape[0]]
+        bias_vl = getattr(moe.gate, "bias_vl", None)
+        router_logits, _ = moe.gate(hidden_states)
+        weights, ids = fused_topk_bias(
+            hidden_states=hidden_states,
+            gating_output=router_logits,
+            scoring_func=moe.scoring_func,
+            e_score_correction_bias=moe.gate.e_score_correction_bias.data,
+            topk=moe.n_activated_experts,
+            renormalize=moe.renormalize,
+            input_tokens=input_ids,
+            routed_scaling_factor=1.0,
+            bias_vl=bias_vl.data if bias_vl is not None else None,
+            image_sentinel_lo=moe.image_sentinel_lo if bias_vl is not None else 0,
+        )
+        record = {
+            "hidden_states": hidden_states[valid],
+            "input_ids": input_ids[valid] if input_ids is not None else None,
+            "topk_ids": ids[valid],
+            "topk_weights": weights[valid],
+        }
+        record = {k: v.cpu() for k, v in record.items() if v is not None}
+        self.counts[layer] = count + record["topk_ids"].shape[0]
+        self.pending.setdefault(layer, []).append(record)
+        if (
+            sum(r["topk_ids"].shape[0] for r in self.pending[layer]) >= 4096
+            or self.counts[layer] >= self.max_tokens
+        ):
+            self._flush(layer)
+
+    def _flush(self, layer: int) -> None:
+        records = self.pending.pop(layer, [])
+        if not records:
+            return
+        merged = {k: torch.cat([r[k] for r in records]) for k in records[0]}
+        index = self.files.get(layer, 0)
+        self.files[layer] = index + 1
+        path = os.path.join(self.directory, f"L{layer}-{index:05d}.pt")
+        torch.save(merged, path + ".tmp")
+        os.replace(path + ".tmp", path)
+        logger.info(
+            "DSpark router capture: layer %d, %d tokens recorded",
+            layer,
+            self.counts[layer],
+        )
+
+
+def arm_router_capture() -> None:
+    """Start recording; the worker calls this after warmup."""
+    _RouterCapture.armed = True
 
 
