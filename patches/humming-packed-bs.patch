+def pack_scale_nibbles(weight_scale: torch.Tensor) -> torch.Tensor:
+    """Pack adjacent 4-bit scale values along the last dimension, low nibble first.
+
+    Byte i of the result holds elements 2i (bits 0-3) and 2i+1 (bits 4-7), so a
+    16-bit read of elements (2i, 2i+1) becomes an 8-bit read of byte i.
+    """
+    scales = weight_scale.view(torch.uint8)
+    if scales.shape[-1] % 2:
+        raise ValueError(f"packed scales need an even last dimension, got {tuple(scales.shape)}")
+    if int(scales.max()) > 15:
+        raise ValueError(f"scale value {int(scales.max())} does not fit in 4 bits")
+    packed = scales[..., 0::2] | (scales[..., 1::2] << 4)
+    return packed.contiguous().view(weight_scale.dtype)
+
+
