+    query_end = tl.load(query_start_loc_ptr + req + 1, mask=valid, other=0)
+    position = tl.load(positions_ptr + offsets, mask=valid, other=0)
+    block = tl.load(block_table_ptr + req * block_table_stride, mask=valid, other=-1)
+    valid &= block >= 0
