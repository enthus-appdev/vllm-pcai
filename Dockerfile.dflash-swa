# EXPERIMENTAL / VALIDATION ONLY — production base + vLLM PR #40898 (DFlash Sliding Window Attention).
#
# Identical to the production image (same nightly base + enhanced template) PLUS
# patches/40898-on-nightly.patch = PR #40898 (jianc99, "Add SWA support to the DFlash drafter") rebased +
# conflict-resolved onto cu129-nightly-6607a80d. Pure-Python overlay, no CUDA recompile.
#
# WHY: without #40898 the drafter's sliding-window layers run as FULL attention and lose acceptance length
# at high k (z-lab: "the root cause of low acceptance rate"). The NVIDIA-forum benchmark shows #40898 is
# ~2-2.8x faster at dflash=15 (but a wash at dflash=6) — i.e. it unlocks HIGH-k DFlash.
#
# ⚠️ UNVALIDATED. A clean apply is NOT proof of correctness — our earlier #40898 hand-port applied fine yet
# gave 6% acceptance. The ONLY proof is the GPU per-position acceptance curve at k=15: deep positions
# (pos 5-14) must accept FAR better than the stock curve (12% @ pos 10). If it nose-dives → resolution is
# wrong → fall back to a from-source build of jianc99's branch. Keep --attention-backend flash_attn
# (FlashInfer + #40898 reproduced a "Window left is not the same for all layers" crash, vLLM #39995).
FROM vllm/vllm-openai:cu129-nightly-6607a80dabfa03932515808895b016d2666b0a55

# Same enhanced template as the production image (PCAI can't mount volumes).
COPY chat-template-fix/chat-template/*.jinja /templates/

COPY patches/40898-on-nightly.patch /tmp/dflash-swa.patch
RUN set -eux; \
    VLLM_DIR="$(python3 -c 'import vllm, os; print(os.path.dirname(vllm.__file__))')"; SITE="$(dirname "$VLLM_DIR")"; \
    if command -v git >/dev/null 2>&1; then git -C "$SITE" apply -p1 --verbose /tmp/dflash-swa.patch; \
    else patch -p1 -d "$SITE" < /tmp/dflash-swa.patch; fi; \
    find "$VLLM_DIR" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true; \
    rm -f /tmp/dflash-swa.patch

# Build-time tripwire: a broken/partial apply fails HERE (does NOT catch the 6% semantic bug — needs GPU).
RUN python3 - <<'PY'
import vllm
import vllm.v1.spec_decode.dflash, vllm.v1.spec_decode.llm_base_proposer
import vllm.model_executor.models.qwen3_dflash
import vllm.v1.worker.gpu_model_runner, vllm.v1.core.sched.scheduler, vllm.config.speculative
print("DFlash+SWA(#40898) overlay import OK:", vllm.__version__)
PY
