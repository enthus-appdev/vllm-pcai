diff --git a/checks/test_local_model.py b/checks/test_local_model.py
new file mode 100644
index 0000000..c5b6e72
--- /dev/null
+++ b/checks/test_local_model.py
@@ -0,0 +1,121 @@
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from test_chart import render, deployment
+
+FILES = Path(__file__).resolve().parents[1] / 'charts/pcai-inference/files'
+sys.path.insert(0, str(FILES))
+import stage
+
+RECEIPT = dict(enabled=True, revision='a' * 40, manifestSha256='b' * 64,
+               markerId='test-marker', files=1, bytes=100)
+
+
+def config(data=b'test'):
+    return dict(enabled=True, existingClaim='original-model', sizeLimit='230Gi', freeHeadroom='1',
+                sourceVerify=RECEIPT, files=[dict(path='table.safetensors', size=len(data),
+                sha256=hashlib.sha256(data).hexdigest())])
+
+
+class LocalModelChart(unittest.TestCase):
+    def test_disabled_default(self):
+        spec = deployment(render())['spec']['template']['spec']
+        self.assertNotIn('local-model', [v['name'] for v in spec['volumes']])
+        self.assertEqual(len(spec['initContainers']), 1)
+
+    def test_disk_volume_and_readonly_source(self):
+        docs = render({'localModel': config(), 'resources': {
+            'requests': {'ephemeral-storage': '240Gi'}, 'limits': {'ephemeral-storage': '260Gi'}}})
+        spec = deployment(docs)['spec']['template']['spec']
+        vols = {v['name']: v for v in spec['volumes']}
+        self.assertEqual(vols['local-model']['emptyDir'], {'sizeLimit': '230Gi'})
+        self.assertTrue(vols['local-source']['persistentVolumeClaim']['readOnly'])
+        main = spec['containers'][0]
+        mounts = {m['name']: m for m in main['volumeMounts']}
+        self.assertTrue(mounts['local-model']['readOnly'])
+        self.assertNotIn('local-source', mounts)
+        init = spec['initContainers'][1]
+        self.assertTrue(init['securityContext']['readOnlyRootFilesystem'])
+        mounts = {m['name']: m for m in init['volumeMounts']}
+        self.assertTrue(mounts['local-source']['readOnly'])
+        self.assertNotIn('nvidia.com/gpu', init['resources']['limits'])
+
+    def test_reject_unpinned_or_unreserved_staging(self):
+        render({'localModel': config()}, success=False)
+        for field, value in [('existingClaim', ''), ('files', []), ('sourceVerify', {'enabled': False})]:
+            c = config()
+            c[field] = value
+            render({'localModel': c}, success=False)
+
+
+class Staging(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.source = self.root / 'source'
+        self.target = self.root / 'target'
+        self.source.mkdir()
+        (self.source / '.pcai-preparation').mkdir()
+        done = dict(revision=RECEIPT['revision'], manifest_sha256=RECEIPT['manifestSha256'],
+                    storage_marker_id=RECEIPT['markerId'], files=1, bytes=100)
+        (self.source / '.pcai-preparation/complete.json').write_text(json.dumps(done))
+        revision = self.source / 'revisions' / RECEIPT['revision']
+        revision.mkdir(parents=True)
+        (revision / 'table.safetensors').write_bytes(b'test')
+        self.env = dict(LOCAL_MODEL=json.dumps(config()), LOCAL_SOURCE_ROOT=str(self.source),
+                        LOCAL_TARGET_ROOT=str(self.target))
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_copy_hash_and_idempotency(self):
+        stage.stage(self.env, require_readonly=False)
+        self.assertEqual((self.target / 'table.safetensors').read_bytes(), b'test')
+        with patch.object(stage, 'copy_verified', side_effect=AssertionError('copied twice')):
+            stage.stage(self.env, require_readonly=False)
+        self.assertTrue((self.target / '.pcai-stage-complete.json').is_file())
+        self.assertFalse(list(self.target.glob('*.partial')))
+
+    def test_integrity_failure_never_commits(self):
+        c = config()
+        c['files'][0]['sha256'] = '0' * 64
+        self.env['LOCAL_MODEL'] = json.dumps(c)
+        with self.assertRaisesRegex(ValueError, 'integrity'):
+            stage.stage(self.env, require_readonly=False)
+        self.assertFalse((self.target / 'table.safetensors').exists())
+        self.assertFalse((self.target / '.pcai-stage-complete.json').exists())
+        self.assertFalse(list(self.target.glob('*.partial')))
+
+    def test_receipt_mismatch(self):
+        c = config()
+        c['sourceVerify'] = dict(RECEIPT, markerId='wrong')
+        self.env['LOCAL_MODEL'] = json.dumps(c)
+        with self.assertRaisesRegex(ValueError, 'receipt'):
+            stage.stage(self.env, require_readonly=False)
+
+    def test_source_must_be_readonly(self):
+        with self.assertRaisesRegex(ValueError, 'read-only'):
+            stage.stage(self.env)
+
+    def test_path_traversal(self):
+        for name in ['../elsewhere', '/absolute', '.', 'dir/file']:
+            with self.assertRaises(ValueError):
+                stage.pinned_file(self.target, name)
+
+    def test_insufficient_space(self):
+        c = config()
+        c['freeHeadroom'] = '999Ti'
+        self.env['LOCAL_MODEL'] = json.dumps(c)
+        with self.assertRaisesRegex(ValueError, 'free space'):
+            stage.stage(self.env, require_readonly=False)
+
+
+if __name__ == '__main__':
+    unittest.main()

