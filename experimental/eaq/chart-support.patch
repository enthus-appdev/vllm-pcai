diff --git a/charts/pcai-inference/files/stage.py b/charts/pcai-inference/files/stage.py
new file mode 100644
index 0000000..e623f26
--- /dev/null
+++ b/charts/pcai-inference/files/stage.py
@@ -0,0 +1,114 @@
+"""Stage selected, hash-pinned model files from read-only PVC to disk emptyDir."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+
+from check import quantity_bytes
+
+CHUNK = 4 * 1024 * 1024
+SYNC_EVERY = 32 * 1024 * 1024
+
+
+def pinned_file(root, name):
+    if not name or Path(name).name != name or name in ('.', '..'):
+        raise ValueError('staging accepts plain filenames only')
+    root = Path(root).resolve()
+    target = (root / name).resolve()
+    if not target.is_relative_to(root):
+        raise ValueError('staging path escapes volume')
+    return target
+
+
+def digest(path):
+    h = hashlib.sha256()
+    with path.open('rb') as f:
+        while block := f.read(CHUNK):
+            h.update(block)
+            os.posix_fadvise(f.fileno(), 0, f.tell(), os.POSIX_FADV_DONTNEED)
+    return h.hexdigest()
+
+
+def matches(path, spec):
+    return path.is_file() and path.stat().st_size == spec['size'] and digest(path) == spec['sha256']
+
+
+def copy_verified(source, target, spec):
+    partial = target.with_name(target.name + '.partial')
+    h = hashlib.sha256()
+    copied = 0
+    try:
+        with source.open('rb') as src, partial.open('wb') as dst:
+            while block := src.read(CHUNK):
+                dst.write(block)
+                h.update(block)
+                copied += len(block)
+                if copied % SYNC_EVERY == 0:
+                    dst.flush()
+                    os.fsync(dst.fileno())
+                    os.posix_fadvise(dst.fileno(), 0, copied, os.POSIX_FADV_DONTNEED)
+                    os.posix_fadvise(src.fileno(), 0, copied, os.POSIX_FADV_DONTNEED)
+            dst.flush()
+            os.fsync(dst.fileno())
+            os.posix_fadvise(dst.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
+            os.posix_fadvise(src.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
+        if copied != spec['size'] or h.hexdigest() != spec['sha256']:
+            raise ValueError('source integrity mismatch for ' + spec['path'])
+        # Independent destination read verifies the actual staged file, not just input bytes.
+        if not matches(partial, spec):
+            raise ValueError('destination integrity mismatch for ' + spec['path'])
+        os.replace(partial, target)
+    finally:
+        partial.unlink(missing_ok=True)
+
+
+def stage(env, require_readonly=True):
+    spec = json.loads(env['LOCAL_MODEL'])
+    source_root = Path(env['LOCAL_SOURCE_ROOT'])
+    target = Path(env['LOCAL_TARGET_ROOT'])
+    if require_readonly and not os.statvfs(source_root).f_flag & os.ST_RDONLY:
+        raise ValueError('source PVC must be mounted read-only')
+    revision = spec['sourceVerify']['revision']
+    if not re.fullmatch('[a-f0-9]{40}', revision):
+        raise ValueError('source revision must be immutable')
+    done = json.loads((source_root / '.pcai-preparation/complete.json').read_text())
+    expected = spec['sourceVerify']
+    for key, field in [('revision', 'revision'), ('manifest_sha256', 'manifestSha256'),
+                       ('storage_marker_id', 'markerId'), ('files', 'files'), ('bytes', 'bytes')]:
+        if done.get(key) != expected[field]:
+            raise ValueError('source receipt mismatch: ' + key)
+    source = source_root / 'revisions' / revision
+    target.mkdir(parents=True, exist_ok=True)
+    receipt = target / '.pcai-stage-complete.json'
+    receipt.unlink(missing_ok=True)
+    todo = []
+    seen = set()
+    for item in spec['files']:
+        if item['path'] in seen or not re.fullmatch('[a-f0-9]{64}', item['sha256']) or item['size'] <= 0:
+            raise ValueError('invalid or duplicate staging manifest entry')
+        seen.add(item['path'])
+        src, dst = pinned_file(source, item['path']), pinned_file(target, item['path'])
+        if not src.is_file() or src.stat().st_size != item['size']:
+            raise ValueError('source file absent or size mismatch: ' + item['path'])
+        # Clean a previous failed attempt before calculating free space.
+        dst.with_name(dst.name + '.partial').unlink(missing_ok=True)
+        if not matches(dst, item):
+            dst.unlink(missing_ok=True)
+            todo.append((src, dst, item))
+    stats = os.statvfs(target)
+    required = sum(item['size'] for _, _, item in todo) + quantity_bytes(spec['freeHeadroom'])
+    if stats.f_bavail * stats.f_frsize < required:
+        raise ValueError('insufficient current local free space including headroom')
+    for src, dst, item in todo:
+        copy_verified(src, dst, item)
+        print(json.dumps({'staged_verified': item['path'], 'bytes': item['size']}), flush=True)
+    result = {'revision': revision, 'files': spec['files']}
+    temporary = target / '.pcai-stage-complete.partial'
+    temporary.write_text(json.dumps(result))
+    os.replace(temporary, receipt)
+    return result
+
+
+if __name__ == '__main__':
+    print(json.dumps(stage(os.environ)), flush=True)
