 {{- $args = concat $args (list "--host" "0.0.0.0" "--port" "8080" "--tp-size" $gpus) -}}
-{{- with $s.maxModelLen }}{{ $args = concat $args (list "--context-length" (toString .)) }}{{ end -}}
-{{- with $s.maxNumSeqs }}{{ $args = concat $args (list "--max-running-requests" (toString .)) }}{{ end -}}
-{{- with $s.maxNumBatchedTokens }}{{ $args = concat $args (list "--chunked-prefill-size" (toString .)) }}{{ end -}}
-{{- with $s.gpuMemoryUtilization }}{{ $args = concat $args (list "--mem-fraction-static" (toString .)) }}{{ end -}}
+{{- with $s.maxModelLen }}{{ $args = concat $args (list "--context-length" (include "inference.num" .)) }}{{ end -}}
+{{- with $s.maxNumSeqs }}{{ $args = concat $args (list "--max-running-requests" (include "inference.num" .)) }}{{ end -}}
+{{- with $s.maxNumBatchedTokens }}{{ $args = concat $args (list "--chunked-prefill-size" (include "inference.num" .)) }}{{ end -}}
+{{- with $s.gpuMemoryUtilization }}{{ $args = concat $args (list "--mem-fraction-static" (include "inference.num" .)) }}{{ end -}}
 {{- if $s.hostOffload }}{{ fail "serving.hostOffload is supported only for engine vllm" }}{{ end -}}
 {{- end -}}
