+{{- with $s.maxNumBatchedTokens }}{{ $args = concat $args (list "--max-num-batched-tokens" (include "inference.num" .)) }}{{ end -}}
+{{- with $s.gpuMemoryUtilization }}{{ $args = concat $args (list "--gpu-memory-utilization" (include "inference.num" .)) }}{{ end -}}
