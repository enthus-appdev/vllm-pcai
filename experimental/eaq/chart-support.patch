+++ b/checks/test_scripts.py
@@ -0,0 +1,149 @@
+"""Init scripts against temporary prepared-volume fixtures; no cluster or GPU."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "charts/pcai-inference/files"))
+import check  # noqa: E402
+import stage  # noqa: E402
+
+REV = "a" * 40
+
+
+def prepare(root, contents):
+    """Mimic the preparation job: snapshot files, manifest.json, then complete.json."""
+    files = []
+    snapshot = root / "revisions" / REV
+    snapshot.mkdir(parents=True)
+    for name, data in contents.items():
+        (snapshot / name).write_bytes(data)
+        if name.endswith(".safetensors"):
+            files.append({"path": name, "size": len(data), "sha256": hashlib.sha256(data).hexdigest()})
+        else:
+            blob = hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()
+            files.append({"path": name, "size": len(data), "git_blob_id": blob})
+    encoded = json.dumps({"repo": "org/model", "revision": REV, "files": files}).encode()
+    (root / ".pcai-preparation").mkdir()
+    (root / ".pcai-preparation/manifest.json").write_bytes(encoded)
+    (root / ".pcai-preparation/complete.json").write_text(json.dumps(
+        {"revision": REV, "manifest_sha256": hashlib.sha256(encoded).hexdigest()}))
+
+
+class Fixture(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.base = Path(self.tmp.name)
+        self.source = self.base / "source"
+        self.target = self.base / "target"
+        self.target.mkdir()
+        prepare(self.source, {"a.safetensors": b"tensor-a", "b.safetensors": b"tensor-b", "index.json": b"{}"})
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def readonly(self, paths):
+        real = os.statvfs
+
+        def fake(path):
+            r = real(path)
+            flag = r.f_flag | os.ST_RDONLY if str(path) in paths else r.f_flag
+            return os.statvfs_result((r.f_bsize, r.f_frsize, r.f_blocks, r.f_bfree, r.f_bavail,
+                                      r.f_files, r.f_ffree, r.f_favail, flag, r.f_namemax))
+        return mock.patch("os.statvfs", fake)
+
+
+class StorageCheck(Fixture):
+    def env(self, **extra):
+        return {"MODEL_ROOT": str(self.source), "MODEL_REVISION": REV, "SHM_SIZE": "1Ki",
+                "CACHE_ROOT": str(self.base / "cache/vllm"), **extra}
+
+    def test_pass(self):
+        with self.readonly({str(self.source)}):
+            result = check.check(self.env(), shm=self.tmp.name)
+        self.assertEqual(result["model_files"], 3)
+        self.assertTrue((self.base / "cache/vllm").is_dir())
+
+    def test_writable_model_rejected(self):
+        with self.assertRaisesRegex(SystemExit, "read-only"):
+            check.check(self.env(), shm=self.tmp.name)
+
+    def test_wrong_revision(self):
+        with self.readonly({str(self.source)}), self.assertRaisesRegex(SystemExit, "not " + "b" * 40):
+            check.check(self.env(MODEL_REVISION="b" * 40), shm=self.tmp.name)
+
+    def test_incomplete_preparation(self):
+        (self.source / ".pcai-preparation/complete.json").unlink()
+        with self.readonly({str(self.source)}), self.assertRaisesRegex(SystemExit, "not a completely prepared"):
+            check.check(self.env(), shm=self.tmp.name)
+
+    def test_tampered_manifest(self):
+        path = self.source / ".pcai-preparation/manifest.json"
+        path.write_bytes(path.read_bytes().replace(b"org/model", b"org/other"))
+        with self.readonly({str(self.source)}), self.assertRaisesRegex(SystemExit, "completion record"):
+            check.check(self.env(), shm=self.tmp.name)
+
+    def test_truncated_file(self):
+        (self.source / "revisions" / REV / "a.safetensors").write_bytes(b"short")
+        with self.readonly({str(self.source)}), self.assertRaisesRegex(SystemExit, "wrong size"):
+            check.check(self.env(), shm=self.tmp.name)
+
+    def test_small_shm(self):
+        with self.readonly({str(self.source)}), self.assertRaises(SystemExit):
+            check.check(self.env(SHM_SIZE="1024Ti"), shm=self.tmp.name)
+
+    def test_quantities(self):
+        self.assertEqual(check.quantity_bytes("64Gi"), 64 * 2**30)
+        self.assertEqual(check.quantity_bytes("500M"), 500 * 10**6)
+        with self.assertRaises(ValueError):
+            check.quantity_bytes("64GB")
+
+
+class Staging(Fixture):
+    def env(self, files=("a.safetensors", "index.json"), size="1Ki"):
+        return {"STAGE_SOURCE": str(self.source), "STAGE_TARGET": str(self.target),
+                "STAGE_REVISION": REV, "STAGE_FILES": json.dumps(list(files)), "STAGE_SIZE": size}
+
+    def run_stage(self, env):
+        with mock.patch.object(stage, "HEADROOM", 0), self.readonly({str(self.source)}):
+            return stage.stage(env)
+
+    def test_copies_only_listed_files_and_reuses(self):
+        self.run_stage(self.env())
+        self.assertEqual((self.target / "a.safetensors").read_bytes(), b"tensor-a")
+        self.assertEqual((self.target / "index.json").read_bytes(), b"{}")
+        self.assertFalse((self.target / "b.safetensors").exists())
+        with mock.patch.object(stage, "copy", side_effect=AssertionError("copied again")):
+            self.run_stage(self.env())
+
+    def test_corrupt_existing_copy_replaced(self):
+        self.run_stage(self.env())
+        (self.target / "a.safetensors").write_bytes(b"tensor-X")
+        self.run_stage(self.env())
+        self.assertEqual((self.target / "a.safetensors").read_bytes(), b"tensor-a")
+
+    def test_corrupt_source_never_committed(self):
+        (self.source / "revisions" / REV / "a.safetensors").write_bytes(b"tensor-X")
+        with self.assertRaisesRegex(SystemExit, "does not match"):
+            self.run_stage(self.env())
+        self.assertEqual(list(self.target.iterdir()), [])
+
+    def test_unknown_file(self):
+        with self.assertRaisesRegex(SystemExit, "not in revision"):
+            self.run_stage(self.env(files=["../../etc/passwd"]))
+
+    def test_size_budget(self):
+        with self.assertRaisesRegex(SystemExit, "more than stagedFiles.size"):
+            self.run_stage(self.env(size="4"))
+
+    def test_source_must_be_readonly(self):
+        with self.assertRaisesRegex(SystemExit, "read-only"):
+            stage.stage(self.env())
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
