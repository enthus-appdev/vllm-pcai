 {{- if .Values.compileCache.enabled -}}/cache/{{ .Values.engine }}{{- else -}}/runtime/cache-{{ .Values.engine }}{{- end -}}
 {{- end -}}

+{{/* A number as a command-line string: integers without exponent (1048576, not 1.048576e+06). */}}
+{{- define "inference.num" -}}
+{{- if eq (float64 .) (float64 (int64 .)) -}}{{ int64 . }}{{- else -}}{{ . }}{{- end -}}
+{{- end -}}
