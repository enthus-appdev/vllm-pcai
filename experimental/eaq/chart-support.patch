+{{- $args = concat $args (list "--offload-backend" "uva" "--cpu-offload-gb" (include "inference.num" .gibPerGpu)) -}}
 {{- with .params }}{{ $args = concat $args (list "--cpu-offload-params") . }}{{ end -}}
