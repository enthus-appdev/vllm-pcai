-{{- with $s.maxModelLen }}{{ $args = concat $args (list "--max-model-len" (toString .)) }}{{ end -}}
-{{- with $s.maxNumSeqs }}{{ $args = concat $args (list "--max-num-seqs" (toString .)) }}{{ end -}}
