@@ -0,0 +1,30 @@
+{{- if .Values.ezua.virtualService.enabled }}
+# PCAI imported-application route through the shared platform gateway.
+apiVersion: networking.istio.io/v1alpha3
+kind: VirtualService
+metadata:
+  name: {{ .Release.Name }}
+  labels:
+    {{- include "inference.selectorLabels" . | nindent 4 }}
+spec:
+  hosts:
+    - {{ required "ezua.virtualService.endpoint is required" .Values.ezua.virtualService.endpoint | quote }}
+  gateways:
+    - {{ .Values.ezua.virtualService.istioGateway | quote }}
+  http:
+    - match:
+        - uri:
+            prefix: /
+      rewrite:
+        uri: /
+      # Long generations and cold long-context prefill exceed default route timeouts.
+      timeout: {{ .Values.ezua.virtualService.timeout | quote }}
+      # Inference requests are not idempotent; never replay them at the gateway.
+      retries:
+        attempts: 0
+      route:
+        - destination:
+            host: {{ printf "%s.%s.svc.cluster.local" .Release.Name .Release.Namespace }}
+            port:
+              number: {{ .Values.port }}
+{{- end }}
