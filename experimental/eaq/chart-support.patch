From bcaa0085c928364a6110e5229c8ea0f91d03be50 Mon Sep 17 00:00:00 2001
From: Florian Kinder <florian.kinder@enthus.de>
Date: Wed, 28 Oct 2026 17:18:22 +0100
Subject: [PATCH 08/10] feat: EAQ dense layers as BF16 and exact-size pinned
 host buffers

---
 charts/pcai-inference/values.yaml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/charts/pcai-inference/values.yaml b/charts/pcai-inference/values.yaml
index 12bb3e3..00494ca 100644
--- a/charts/pcai-inference/values.yaml
+++ b/charts/pcai-inference/values.yaml
@@ -8,7 +8,7 @@ engine: vllm
 image:
   repository: ghcr.io/enthus-appdev/vllm-pcai
   # vLLM build with EXL3 kernels and the disk-backed Engram reader.
-  digest: sha256:a989e911ba26f2120196f4ba4a3b92701b202dee5e853776c58096305ecb3388
+  digest: sha256:4189a23e150255f1b83b573ee20d4fe3fb81fa4e680b28f028ea4667335b94f5

 model:
   # Prepared model PVC (mounted read-only) and the revision to serve from it.
@@ -54,6 +54,10 @@ env:
   VLLM_SPARSE_INDEXER_MAX_LOGITS_MB: "128"
   VLLM_ENGINE_READY_TIMEOUT_S: "3600"
   VLLM_EXL3_REQUIRE_UVA_EXPERTS: "1"
+  # EAQ also quantizes attention, shared experts and the head: load those as BF16.
+  PCAI_EXL3_DENSE: bf16
+  # Pinned host buffers are otherwise rounded up to a power of two (up to 2x).
+  PYTORCH_ALLOC_CONF: pinned_max_round_threshold_mb:64
   # Read the Engram tables from the staged copy below instead of host RAM.
   PCAI_ENGRAM_DIR: /staged


